import { readFileSync } from "node:fs";
import { bacaParagrafTemplate } from "./src/lib/instrumen/template.ts";
import { uraiTemplate, untukJenjang, petakanSubBagian } from "./src/lib/domain/template-led.ts";
const p = await bacaParagrafTemplate(readFileSync("tests/fikstur/instrumen/template-ledps-2025.docx"));
const semua = uraiTemplate(p);
for (const b of semua) console.log(b.kode, b.jenis, b.sub.length, b.nama.slice(0, 40));
const s1 = untukJenjang(semua, "S1");
const seed = JSON.parse(readFileSync("data/instrumen/lamteknik-2025-pasca.json", "utf8"));
const ruj = seed.bagian.flatMap((b: any) => b.subBagian.map((s: any) => ({ bagianKode: b.kode, kode: s.kode, label: s.label ?? "", judul: s.judul, grup: s.grup, tipe: s.tipe, instruksi: s.varian.map((v: any) => v.instruksi), berlaku: s.berlakuUntuk, jenjangOverride: s.jenjangOverride })));
const peta = petakanSubBagian(s1, ruj, { jenjang: "S1", semuaVarian: semua });
const hasil = peta.flatMap((x) => x.sub);
const seedS1 = ruj.filter((r: any) => (r.jenjangOverride?.length ? r.jenjangOverride : r.berlaku).includes("S1") && !/^AWAL/.test(r.kode));
const dapat = new Set(hasil.map((h) => h.kode));
console.log("hasil", hasil.length, "seed S1", seedS1.length, "cocok", seedS1.filter((r: any) => dapat.has(r.kode)).length);
console.log("seed tidak ditemukan:", seedS1.filter((r: any) => !dapat.has(r.kode)).map((r: any) => r.kode).join(" "));
console.log("baru:", hasil.filter((h) => !h.dariRujukan).map((h) => `${h.kode}=${h.judul.slice(0, 40)}`).join(" | "));
for (const h of hasil.filter((h) => /^C\.(2|3)-IKU-(a\.(i|0[89]|1[0])|baru)/.test(h.kode) || /^C\.3-IKU-a\.(09|10)/.test(h.dariRujukan ?? ""))) console.log(h.kode, "<=", h.dariRujukan, "|", h.judul, "|", h.varian.map((v) => v.instruksi.slice(0, 70)).join(" // "));
const c3 = s1.find((b) => b.kode === "C.3")!;
console.log(c3.sub.slice(8, 12).map((s) => s.jalur.join(">") + " :: " + s.judul + " :: " + s.varian[0].instruksi.slice(0, 60)).join("\n"));
