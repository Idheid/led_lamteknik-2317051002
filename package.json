  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "npm run test:unit && npm run test:integrasi",
    "test:unit": "tsx --test \"src/lib/domain/__tests__/*.test.ts\"",
