    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "lucide-react": "1.49.0",
    "next": "16.3.8",
    "next-themes": "^0.4.6",
    "pg": "8.23.1",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "7.89.0",
    "server-only": "0.0.1",
    "shadcn": "^4.21.1",
    "sonner": "^2.0.8",
