# Salin menjadi .env lalu isi. Jangan commit .env.

# Basis data (sesuai docker-compose.yml)
DATABASE_URL="postgresql://led:led_lokal_ganti@localhost:5432/led_lamteknik?schema=public"

# Better Auth
BETTER_AUTH_SECRET="ganti-dengan-string-acak-32-karakter-atau-lebih"
BETTER_AUTH_URL="http://localhost:3000"

# Enkripsi kunci API LLM (AES-256-GCM). Buat dengan:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=""

# Akun Admin UPPS pertama (dipakai skrip seed; nama variabel SUPERADMIN_* dipertahankan supaya .env lama tetap jalan)
SUPERADMIN_NAMA="Admin UPPS"
SUPERADMIN_EMAIL="admin@contoh.ac.id"
SUPERADMIN_PASSWORD="ganti-kata-sandi-kuat"

# Penyimpanan berkas unggahan dan hasil ekspor
UPLOAD_DIR="./uploads"

# Template LEDPS resmi untuk ekspor (iterasi 4)
TEMPLATE_LEDPS_PATH="../Led Lamteknik/Instrumen_Akreditasi_LAM_Teknik_2025 (dari lamteknik.or.id)/01_Pasca Terakreditasi Pertama dan Unggul/Template LEDPS LAM Teknik Pasca Akreditasi Minimum dan Unggul Instrumen LAM Teknik 2025 (Seluruh Jenjang).docx"

# LibreOffice untuk menghitung halaman (iterasi 4). Contoh Windows:
SOFFICE_PATH="C:\\Program Files\\LibreOffice\\program\\soffice.exe"

# Bulan mulai tahun akademik (Unila: Agustus)
BULAN_MULAI_TA=8

# Template LKPS asli (hanya untuk skrip pembuat fikstur uji dan peta kolom PDF; aplikasi tidak membutuhkannya)
TEMPLATE_LKPS_PATH="../Led Lamteknik/Instrumen_Akreditasi_LAM_Teknik_2025 (dari lamteknik.or.id)/01_Pasca Terakreditasi Pertama dan Unggul/Template LKPS APS Vokasi dan Akademik Instrumen LAM Teknik 2025 Pasca Akreditasi Minimum dan Unggul (Seluruh Jenjang).xlsx"

# Embedding uji lokal tanpa kunci Gemini (BUKAN embedding semantik; hanya untuk uji otomatis/demo lokal).
# Isi "uji" untuk aplikasi DAN worker; jangan dipakai di produksi.
# EMBEDDING_PENYEDIA="uji"

# Model narasi uji tanpa kunci dan tanpa memanggil Gemini (teks bertanda "[Mode uji]"); untuk mencoba alur
# generate, antrean, editor, dan riwayat versi. Isi untuk aplikasi DAN worker; jangan dipakai di produksi.
# LLM_NARASI="uji"

# Revisi 22 Okt 2026 (kecepatan generate). Bawaan: keluaran dialirkan (teks tampil bertahap), dua sub-bagian
# indikator kinerja dikerjakan bersamaan, dan setiap panggilan Gemini dibatasi 90 detik.
# GENERATE_STREAM="0"
# GENERATE_PARALEL="2"
# GENERATE_BATAS_MS="90000"

# Revisi 22 Okt 2026 (cadangan harian oleh worker; lihat docs/PANDUAN-SERVER.md). Bawaan: folder ./cadangan,
# 14 cadangan terakhir, setiap hari pukul 02.00 WIB. Sebaiknya arahkan ke disk lain.
# Laptop tanpa pg_dump 17: pakai pg_dump di kontainer basis data.
# CADANGAN_DIR="E:\cadangan-led"
# CADANGAN_SIMPAN=14
# CADANGAN_JADWAL="0 2 * * *"
CADANGAN_PG_DUMP="docker exec -i -e PGPASSWORD led-lamteknik-db pg_dump"
CADANGAN_PG_RESTORE="docker exec -i -e PGPASSWORD led-lamteknik-db pg_restore"
# CADANGAN_NONAKTIF="1"

# Akses dari perangkat lain di jaringan lokal (uji awal). Alamat login tambahan untuk Better Auth, dan (khusus
# mode pengembangan) host yang boleh memuat aset dev Next.js:
# BETTER_AUTH_TRUSTED_ORIGINS="http://192.168.1.10:3000"
# ALLOWED_DEV_ORIGINS="192.168.1.10"
