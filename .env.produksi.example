# Produksi dengan docker-compose.produksi.yml. Salin menjadi .env.produksi lalu isi. Jangan commit .env.produksi.

# Kata sandi basis data (huruf dan angka saja, karena dipakai di URL koneksi)
POSTGRES_PASSWORD=""

# Alamat website. ALAMAT_SITUS untuk Caddy, BETTER_AUTH_URL untuk login; keduanya alamat yang sama.
#   Server dengan domain:      ALAMAT_SITUS="led.ft.unila.ac.id"   BETTER_AUTH_URL="https://led.ft.unila.ac.id"
#   Uji di jaringan lokal:     ALAMAT_SITUS="http://192.168.1.10"  BETTER_AUTH_URL="http://192.168.1.10"
ALAMAT_SITUS=""
BETTER_AUTH_URL=""
# Alamat lain yang boleh dipakai login (dipisah koma), mis. alamat IP selain domain
# BETTER_AUTH_TRUSTED_ORIGINS="http://192.168.1.10"
BETTER_AUTH_SECRET=""

# Kunci enkripsi kunci API. Bila memindahkan data dari laptop, WAJIB sama dengan ENCRYPTION_KEY di laptop;
# bila berbeda, kunci API yang tersimpan tidak bisa dibuka dan harus dimasukkan ulang.
ENCRYPTION_KEY=""

# Akun super admin pertama (seed sekali: docker compose ... run --rm web npm run db:seed)
SUPERADMIN_NAMA="Super Admin"
SUPERADMIN_EMAIL=""
SUPERADMIN_PASSWORD=""

BULAN_MULAI_TA=8

# Cadangan harian: folder di server (sebaiknya disk lain atau drive fakultas), jumlah yang disimpan, dan jadwal
# (cron, WIB). Isi CADANGAN_NONAKTIF="1" untuk mematikan.
CADANGAN_FOLDER="./cadangan"
CADANGAN_SIMPAN=14
CADANGAN_JADWAL="0 2 * * *"
