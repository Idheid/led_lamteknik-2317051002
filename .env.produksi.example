# Produksi dengan docker-compose.produksi.yml. Salin menjadi .env.produksi lalu isi. Jangan commit .env.produksi.

# Kata sandi basis data (huruf dan angka saja, karena dipakai di URL koneksi)
POSTGRES_PASSWORD=""

# Alamat website. ALAMAT_SITUS untuk Caddy, BETTER_AUTH_URL untuk login; keduanya alamat yang sama.
#   Server dengan domain:      ALAMAT_SITUS="led.ft.unila.ac.id"   BETTER_AUTH_URL="https://led.ft.unila.ac.id"
#   Uji di jaringan lokal:     ALAMAT_SITUS="http://192.168.1.10"  BETTER_AUTH_URL="http://192.168.1.10"
ALAMAT_SITUS=""
BETTER_AUTH_URL=""
# Alamat lain yang boleh dipakai login (dipisah koma), mis. alamat IP selain domain
# BETTER_AUTH_TRUSTED_ORIGINS="http://192.168.1.10"
BETTER_AUTH_SECRET=""

# Kunci enkripsi kunci API. Bila memindahkan data dari laptop, WAJIB sama dengan ENCRYPTION_KEY di laptop;
# bila berbeda, kunci API yang tersimpan tidak bisa dibuka dan harus dimasukkan ulang.
ENCRYPTION_KEY=""

# Akun super admin pertama (seed sekali: docker compose ... run --rm web npm run db:seed)
SUPERADMIN_NAMA="Super Admin"
SUPERADMIN_EMAIL=""
SUPERADMIN_PASSWORD=""

BULAN_MULAI_TA=8

# Cadangan harian: folder di server (sebaiknya disk lain atau drive fakultas), jumlah yang disimpan, dan jadwal
# (cron, WIB). Isi CADANGAN_NONAKTIF="1" untuk mematikan.
CADANGAN_FOLDER="./cadangan"
CADANGAN_SIMPAN=14
CADANGAN_JADWAL="0 2 * * *"

# Gabung LKPS G6: sinkron One Data (WS API myUnila) di modul LKPS. Mati secara bawaan; menyala hanya bila
# LKPS_ONEDATA_AKTIF="true" dan keempat variabel MYUNILA_* terisi. Tidak ada nilai bawaan di kode; nilai tidak pernah
# dicetak atau dikirim ke browser. Kredensial yang dipakai (aplikasi Adrianne atau Ghalib) belum diputuskan.
# LKPS_ONEDATA_AKTIF="false"
# MYUNILA_API_URL=""
# MYUNILA_APP_ID=""
# MYUNILA_USERNAME=""
# MYUNILA_PASSWORD=""

# Rencana 18 Nov S3/S5: login SSO Unila (API Manajemen Akses). Mati secara bawaan; tombol "Masuk dengan SSO Unila"
# hanya tampil dan rute /api/sso/* hanya berjalan bila SSO_AKTIF="true". Nilai rahasia tidak pernah di-commit.
# SSO_AKTIF="false"
# SSO_MODE="akses"         # "tiruan" ditolak di produksi
# SSO_APP_KEY=""            # app_key Manajemen Akses (rahasia)
# SSO_URL_MULAI=""          # bawaan https://akses.unila.ac.id/api/live/v1/auth/login/sso
# SSO_URL_KEMBALI=""        # URL absolut alamat kembali, mis. https://<domain>/api/sso/kembali
# SSO_URL_KELUAR=""         # URL keluar SSO (S6; menunggu docs/SSO-AKSES-CATATAN.md)
# SSO_DOMAIN_EMAIL_DITOLAK="" # domain email mahasiswa, dipisah koma (menunggu konfirmasi dokumentasi)
