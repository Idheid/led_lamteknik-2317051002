// Skema bersama (dipakai modul LKPS dan LED): pengguna dan akses, fakultas dan program studi, kunci API dan
// pengaturan LLM, log, cadangan, pemberitahuan. Satu basis data untuk seluruh website (31 Okt 2026: skema dipecah
// per modul; isi model tidak berubah). Ekstensi pgvector, indeks HNSW, dan kolom tsvector dibuat lewat migrasi SQL.
// Model modul LED ada di led.prisma, model modul LKPS di lkps.prisma.

// Asal: docs/rancangan/schema.prisma (iterasi 1), disesuaikan dengan Prisma 7 dan Better Auth (plugin admin).

generator client {
  provider = "prisma-client"
  // relatif terhadap folder prisma/schema
  output   = "../../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  // Prisma 7: url diatur di prisma.config.ts (env DATABASE_URL)
}

// ----------------------------------------------------------------- Pengguna dan akses

// Revisi 31 Okt 2026 (Pak Tris): tiga peran. ADMIN = Admin UPPS (dulu SUPER_ADMIN dan PJ fakultas), TIM_PRODI = tim
// penyusun satu prodi (boleh beberapa akun per prodi), ASESOR = reviewer internal yang ditugaskan admin ke satu LED.
enum Peran {
  ADMIN
  TIM_PRODI
  ASESOR
}

model User {
  id            String    @id
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  // kolom plugin admin Better Auth: role = peran, banned = akun dinonaktifkan
  role          Peran     @default(TIM_PRODI)
  banned        Boolean?  @default(false)
  banReason     String?
  banExpires    DateTime?
  // kolom tambahan (Better Auth additionalFields)
  wajibGantiSandi Boolean @default(false) // akun baru atau sandi diatur ulang admin
  // L3 (2 Nov 2026): diisi setiap kali sesi login dibuat (hook Better Auth), untuk memeriksa akun Tim Prodi per periode
  loginTerakhir DateTime?
  // revisi 31 Okt 2026: prodi akun Tim Prodi (wajib untuk TIM_PRODI, kosong untuk peran lain)
  prodiId       String?
  prodi         Prodi?    @relation(fields: [prodiId], references: [id], onDelete: Restrict)

  sessions      Session[]
  accounts      Account[]
  kunciApi      KunciAPI[]
  logAktivitas  LogAktivitas[]
  versiDraf     VersiDraf[]
  // revisi 22 Okt 2026 (asesor)
  ledDireview   ProyekLED[]      @relation("AsesorLED")
  catatanRevisi CatatanRevisi[]
  balasan       BalasanCatatan[]
  pemberitahuan Pemberitahuan[]

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  impersonatedBy String? // plugin admin Better Auth (tidak dipakai)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("verification")
}

// ----------------------------------------------------------------- Organisasi

/// Identitas fakultas (pengganti UPPS, revisi 19 Okt 2026): satu baris untuk satu instalasi website.
model Fakultas {
  id              String   @id @default("utama")
  nama            String
  perguruanTinggi String
  alamat          String?
  kota            String?
  // D7 (desain form 2, 2 Nov 2026): identitas institusi dipakai LED (identitas pengusul) dan LKPS (sheet Menu);
  // SK pendirian PT pindah dari identitas tiap prodi supaya tidak diisi berulang
  statusPt           String?
  kodePos            String?
  telepon            String?
  skPendirian        String?
  tanggalSkPendirian String?
  pejabatSkPendirian String?
  updatedAt       DateTime @updatedAt
}

model Prodi {
  id          String       @id @default(cuid())
  kodePddikti String?      @unique // kunci bersama dengan sistem LKPS
  nama        String
  jenjang     String       // D1, D2, D3, S1, STr, S2, S2Tr, S3, S3Tr, PPI (lihat seed instrumen)
  identitas   Json?        // SK pendirian, SK pembukaan, akreditasi terakhir, alamat, kontak (halaman Identitas Pengusul)
  // akreditasi berlaku sampai: kolom tanggal supaya daftar prodi bisa diurutkan (prodi yang LED-nya paling dekat)
  akreditasiBerlakuSampai DateTime?
  proyek      ProyekLED[]
  anggota     User[]       // akun Tim Prodi prodi ini (revisi 31 Okt 2026)
  riwayatAkreditasi RiwayatAkreditasi[] // L1 (2 Nov 2026): sumber tanggal berakhir, peringkat, dan nomor SK
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

// L1 (2 Nov 2026): riwayat akreditasi prodi. Prodi.akreditasiBerlakuSampai serta identitas.peringkatAkreditasi dan
// identitas.nomorSkAkreditasi diturunkan dari riwayat berlaku terbaru. proyekId = LED yang diajukan (tanpa relasi:
// modul bersama tidak bergantung pada skema LED).
model RiwayatAkreditasi {
  id            String    @id @default(cuid())
  prodiId       String
  prodi         Prodi     @relation(fields: [prodiId], references: [id], onDelete: Cascade)
  lembaga       String    @default("LAM Teknik")
  peringkat     String
  nomorSk       String?
  tanggalSk     DateTime?
  berlakuMulai  DateTime?
  berlakuSampai DateTime?
  proyekId      String?
  berkasSkLokasi String?
  berkasSkNama  String?
  jenis         String    @default("hasil") // hasil (dicatat dari SK), koreksi (koreksi manual di Ubah prodi), awal (data prodi sebelumnya)
  alasan        String?   // wajib untuk koreksi manual; alasan penolakan untuk usulan yang ditolak
  status        String    @default("berlaku") // menunggu (dicatat Tim Prodi), berlaku, ditolak
  dicatatOlehId String?
  dikonfirmasiOlehId String?
  dikonfirmasiPada DateTime?
  createdAt     DateTime  @default(now())

  @@index([prodiId, status, createdAt])
}

// L2 (2 Nov 2026): pengingat akreditasi berakhir yang sudah terkirim (sekali per prodi, tanggal berakhir, dan ambang)
model PengingatTerkirim {
  id            String   @id @default(cuid())
  prodiId       String
  berlakuSampai DateTime
  ambang        Int      // 18, 12, atau 6 bulan
  createdAt     DateTime @default(now())

  @@unique([prodiId, berlakuSampai, ambang])
}

// ----------------------------------------------------------------- Pengaturan LLM

model PengaturanLLM {
  id             String   @id @default("utama")
  penyedia       String   @default("google")
  modelNarasi    String
  modelCadangan  String[]
  modelEmbedding String
  suhu           Float    @default(0.2)
  maksTokenKeluaran Int   @default(4096)
  pakaiCadanganAdmin Boolean @default(true)
  daftarModel    Json?    // hasil models.list Google terakhir (nama, kode, metode, batas token)
  daftarModelDiperbarui DateTime?
  updatedAt      DateTime @updatedAt
}

enum PemilikKunci {
  penanggung_jawab
  super_admin
}

enum StatusKunci {
  aktif
  kuota_habis
  tidak_valid
  nonaktif
}

model KunciAPI {
  id          String       @id @default(cuid())
  label       String
  penyedia    String       @default("google")
  kunciTerenkripsi String  // AES-256-GCM; tidak pernah dikirim ke browser
  akhiran     String       // 4 karakter terakhir untuk tampilan
  pemilik     PemilikKunci
  // akun yang menambahkan; kunci milik fakultas (pemilik penanggung_jawab) atau cadangan admin (super_admin)
  pemilikId   String?
  pemilikUser User?        @relation(fields: [pemilikId], references: [id], onDelete: SetNull)
  status      StatusKunci  @default(aktif)
  habisSampai DateTime?
  urutan      Int          @default(0)
  batasHarian Int?
  log         LogPemakaian[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model LogPemakaian {
  id          String    @id @default(cuid())
  kunciId     String?
  kunci       KunciAPI? @relation(fields: [kunciId], references: [id], onDelete: SetNull)
  proyekId    String?
  subBagianKode String?
  model       String
  tokenMasuk  Int       @default(0)
  tokenKeluar Int       @default(0)
  berhasil    Boolean
  galat       String?
  tugasId     String?
  prodiId     String?
  durasiMs    Int?
  createdAt   DateTime  @default(now())
}

model LogAktivitas {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  aksi      String
  objek     String
  objekId   String?
  detail    Json?
  createdAt DateTime @default(now())
}

// ----------------------------------------------------------------- Cadangan

/// Revisi 22 Okt 2026: riwayat cadangan harian (basis data dan folder unggahan). Admin hanya melihat yang terakhir.
model Cadangan {
  id       String    @id @default(cuid())
  mulai    DateTime  @default(now())
  selesai  DateTime?
  berhasil Boolean? // null = sedang berjalan
  folder   String? // nama folder di CADANGAN_DIR
  ukuranMb Float?
  pesan    String?

  @@index([mulai])
}

// ----------------------------------------------------------------- Pemberitahuan (lonceng, semua modul)

/// Pemberitahuan di ikon lonceng (catatan baru, sudah diperbaiki, diterima, review diajukan, keputusan).
model Pemberitahuan {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  proyekId  String?
  pesan     String
  tautan    String?
  dibaca    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, dibaca, createdAt])
}
