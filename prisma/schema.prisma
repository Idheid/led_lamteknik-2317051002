// Skema data sistem penyusun LED LAM Teknik (iterasi 1).
// Asal: docs/rancangan/schema.prisma, disesuaikan dengan Prisma 7 dan Better Auth (plugin admin).
// Ekstensi pgvector, indeks HNSW, dan kolom tsvector dibuat lewat migrasi SQL (lihat prisma/migrations).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  // Prisma 7: url diatur di prisma.config.ts (env DATABASE_URL)
}

// ----------------------------------------------------------------- Pengguna dan akses

enum Peran {
  SUPER_ADMIN
  PENANGGUNG_JAWAB
}

model User {
  id            String    @id
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  // kolom plugin admin Better Auth: role = peran, banned = akun dinonaktifkan
  role          Peran     @default(PENANGGUNG_JAWAB)
  banned        Boolean?  @default(false)
  banReason     String?
  banExpires    DateTime?
  // kolom tambahan (Better Auth additionalFields). Revisi 19 Okt 2026: PJ = penanggung jawab tingkat fakultas,
  // tidak terikat ke satu prodi (satu instalasi website dipakai satu fakultas).
  wajibGantiSandi Boolean @default(false) // akun baru atau sandi diatur ulang admin

  sessions      Session[]
  accounts      Account[]
  kunciApi      KunciAPI[]
  logAktivitas  LogAktivitas[]
  versiDraf     VersiDraf[]

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  impersonatedBy String? // plugin admin Better Auth (tidak dipakai)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("verification")
}

// ----------------------------------------------------------------- Organisasi

/// Identitas fakultas (pengganti UPPS, revisi 19 Okt 2026): satu baris untuk satu instalasi website.
model Fakultas {
  id              String   @id @default("utama")
  nama            String
  perguruanTinggi String
  alamat          String?
  kota            String?
  updatedAt       DateTime @updatedAt
}

model Prodi {
  id          String       @id @default(cuid())
  kodePddikti String?      @unique // kunci bersama dengan sistem LKPS
  nama        String
  jenjang     String       // D1, D2, D3, S1, STr, S2, S2Tr, S3, S3Tr, PPI (lihat seed instrumen)
  identitas   Json?        // SK pendirian, SK pembukaan, akreditasi terakhir, alamat, kontak (halaman Identitas Pengusul)
  // akreditasi berlaku sampai: kolom tanggal supaya daftar prodi bisa diurutkan (prodi yang LED-nya paling dekat)
  akreditasiBerlakuSampai DateTime?
  proyek      ProyekLED[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

// ----------------------------------------------------------------- Instrumen (diatur super admin)

model VersiInstrumen {
  id          String     @id @default(cuid())
  kode        String     @unique // contoh: LAMTEKNIK-2025-PASCA
  nama        String
  lembaga     String     @default("LAM Teknik")
  peraturan   Json       // daftar peraturan acuan
  catatan     String?
  aktif       Boolean    @default(false)
  disalinDariId String?
  jenjang     Json       // [{ kode, nama }] jenjang yang dikenal versi ini
  statusAkreditasi Json?
  bagian      Bagian[]
  butir       ButirPenilaian[]
  tabelLkps   TabelLkpsAcuan[]
  anggaranBawaan Json    // pengaturan anggaran halaman dan kata
  // template LEDPS resmi (.docx) untuk ekspor; diunggah super admin per versi (cadangan: TEMPLATE_LEDPS_PATH)
  templateLedLokasi String?
  templateLedNama   String?
  templateLedLaporan Json?  // hasil penyiapan per jenjang: placeholder, dihapus, tidak ditemukan
  // Revisi 19 Okt 2026: satu versi untuk satu jenjang, diunggah PJ (Template LED, Matriks Penilaian, Pedoman Penilaian)
  jenjangUtama      String?   // null = versi lama lintas jenjang
  status            String    @default("aktif") // draf, diekstrak, dicek, aktif, nonaktif
  matriksLokasi     String?   // Matriks Penilaian jenjang (.pdf)
  matriksNama       String?
  pedomanLokasi     String?   // Pedoman Penilaian (.pdf), hanya halaman tabel bobot yang dibaca
  pedomanNama       String?
  halamanBobot      String?   // contoh "223-227" (halaman PDF tabel bobot jenjang)
  ekstraksi         Json?     // status dan laporan ekstraksi: { status, pesan, langkah, butir, sub, galat }
  dicekPada         DateTime?
  dicekOlehId       String?
  proyek      ProyekLED[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

enum JenisBagian {
  awal
  bab
  butir     // bagian yang seluruhnya dinilai butir (II.B, Bab III)
  kriteria  // C.1 - C.7
  lampiran
}

// Kriteria dan bab disimpan sebagai Bagian supaya jumlah halaman form mengikuti data (kriteria dinamis).
model Bagian {
  id         String         @id @default(cuid())
  versiId    String
  versi      VersiInstrumen @relation(fields: [versiId], references: [id], onDelete: Cascade)
  kode       String         // AWAL, I, II.A, II.B, C.1 ... C.7, III, IV, LAMPIRAN
  nama       String
  jenis      JenisBagian
  urutan     Int
  batasHalamanResmi Int?
  pengantar  String?
  subBagian  SubBagian[]

  @@unique([versiId, kode])
}

enum TipeSubBagian {
  data      // diisi dari data proyek, tidak di-generate
  narasi    // di-generate, tidak punya butir
  bersama   // latar belakang, kebijakan, analisis faktor, SWOT di setiap kriteria
  iku       // indikator kinerja yang punya butir penilaian
  otomatis  // daftar isi dsb.
}

model SubBagian {
  id          String        @id @default(cuid())
  bagianId    String
  bagian      Bagian        @relation(fields: [bagianId], references: [id], onDelete: Cascade)
  kode        String        // contoh: C.2-IKU-a.i.I
  label       String        // nomor tampilan, contoh 3.a.i.I
  judul       String
  grup        String?
  tipe        TipeSubBagian
  varian      Json          // [{ instruksi, jenjang: [..], catatanTemplate }]
  berlakuUntuk String[]     // kode jenjang
  jenjangOverride String[]  // bila diisi, menimpa jenjang template (lihat catatan)
  sumberInstruksi String    @default("template")
  catatan     String?
  urutan      Int
  butir       ButirSubBagian[]
  dokumenDiharapkan DokumenDiharapkan[]
  draf        BagianDraf[]

  @@unique([bagianId, kode])
}

enum JenisButir {
  narasi
  angka
}

model ButirPenilaian {
  id          String         @id @default(cuid())
  versiId     String
  versi       VersiInstrumen @relation(fields: [versiId], references: [id], onDelete: Cascade)
  jenjang     String         // butir dan bobot berbeda per jenjang
  kode        String         // contoh 4-I
  no          Int
  sub         String?
  urutan      Int
  bagianKode  String         // bagian tempat anggaran butir dihitung (C.1 ... C.7, II.B, III)
  elemen      String
  indikator   String
  bobot       Decimal        @db.Decimal(5, 2)
  jenis       JenisButir
  tabelLkps   String[]
  deskriptorSkor4 String
  unsurSkor4  String[]
  pertanyaanPemandu String? // tidak dipakai lagi (revisi 19 Okt 2026: pertanyaan = instruksi resmi template)
  catatan     String?
  deskriptorSkor3 String?
  deskriptorSkor2 String?
  deskriptorSkor1 String?
  deskriptorSkor0 String?
  kodeRumus   String?        // kunci rumus metrik lama (src/lib/domain/metrik-lkps.ts); null = nilai diisi manual
  dikonfirmasi Boolean @default(true) // false = baris usulan AI yang belum dicek PJ
  usulanAi    String[]       @default([]) // nama kolom yang diusulkan AI dan belum dikonfirmasi
  subBagian   ButirSubBagian[]
  dokumenDiharapkan DokumenDiharapkan[]

  @@unique([versiId, jenjang, kode])
}

// n-m: satu sub-bagian bisa dinilai lebih dari satu butir, dan sebaliknya.
model ButirSubBagian {
  butirId     String
  subBagianId String
  butir       ButirPenilaian @relation(fields: [butirId], references: [id], onDelete: Cascade)
  subBagian   SubBagian      @relation(fields: [subBagianId], references: [id], onDelete: Cascade)

  @@id([butirId, subBagianId])
}

model DokumenDiharapkan {
  id          String          @id @default(cuid())
  nama        String
  butirId     String?
  butir       ButirPenilaian? @relation(fields: [butirId], references: [id], onDelete: Cascade)
  subBagianId String?
  subBagian   SubBagian?      @relation(fields: [subBagianId], references: [id], onDelete: Cascade)
  urutan      Int             @default(0)
  dokumen     Dokumen[]
}

model TabelLkpsAcuan {
  id      String         @id @default(cuid())
  versiId String
  versi   VersiInstrumen @relation(fields: [versiId], references: [id], onDelete: Cascade)
  kode    String         // contoh 4.a
  sheet   String         // nama sheet di template LKPS, contoh 4a
  judul   String

  @@unique([versiId, kode])
}

// ----------------------------------------------------------------- Proyek LED

model ProyekLED {
  id          String         @id @default(cuid())
  prodiId     String
  prodi       Prodi          @relation(fields: [prodiId], references: [id])
  versiId     String
  versi       VersiInstrumen @relation(fields: [versiId], references: [id])
  jenjang     String
  nama        String
  tsTahunMulai Int           // 2025 berarti TS = 2025/2026
  anggaran    Json           // halaman per bagian dan pengaturan (salinan dari versi, bisa diubah)
  timPenyusun Json?          // untuk Tabel 2.1, 2.2 dan halaman identitas tim
  diarsipkanPada DateTime?   // proyek periode lama: tetap tersimpan sebagai rujukan, hanya baca
  // revisi 19 Okt 2026: satu LED = satu pengajuan akreditasi berlaku 5 tahun (periode tahunPengajuan s.d. +5)
  tahunPengajuan Int
  nilaiManual NilaiManual[]
  status      StatusKriteria[]
  berkasLkps  BerkasLKPS[]
  dokumen     Dokumen[]
  draf        BagianDraf[]
  ekspor      Ekspor[]
  tugas       TugasGenerate[]
  jawabanForm JawabanForm[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
}

enum StatusPengisian {
  belum
  draf
  disunting
  selesai
}

/// Nilai hasil hitung butir angka yang tidak punya rumus (atau rumusnya tak bisa membaca LKPS), diisi PJ per LED.
model NilaiManual {
  id         String    @id @default(cuid())
  proyekId   String
  proyek     ProyekLED @relation(fields: [proyekId], references: [id], onDelete: Cascade)
  butirKode  String
  nilai      String    // teks apa adanya (mis. "12,5%" atau "Rasio 1 : 18"); dipakai sebagai sumber data narasi
  keterangan String?
  updatedAt  DateTime  @updatedAt

  @@unique([proyekId, butirKode])
}

model StatusKriteria {
  id        String          @id @default(cuid())
  proyekId  String
  proyek    ProyekLED       @relation(fields: [proyekId], references: [id], onDelete: Cascade)
  bagianKode String         // C.1 ... atau I, III dsb.
  status    StatusPengisian @default(belum)
  updatedAt DateTime        @updatedAt

  @@unique([proyekId, bagianKode])
}

// Jawaban penyusun di form per sub-bagian (pertanyaan pemandu). Sumber "J" di prompt.
model JawabanForm {
  id          String    @id @default(cuid())
  proyekId    String
  proyek      ProyekLED @relation(fields: [proyekId], references: [id], onDelete: Cascade)
  subBagianKode String
  isi         String
  updatedAt   DateTime  @updatedAt

  @@unique([proyekId, subBagianKode])
}

// ----------------------------------------------------------------- Bahan unggahan

model BerkasLKPS {
  id         String     @id @default(cuid())
  proyekId   String
  proyek     ProyekLED  @relation(fields: [proyekId], references: [id], onDelete: Cascade)
  namaBerkas String
  jenis      String     // xlsx atau pdf
  lokasi     String     // path penyimpanan
  status     String     @default("diunggah") // diunggah, diproses, dibaca, gagal
  pesan      String?
  ukuran     Int        @default(0)
  // berkas aktif = sumber metrik proyek (berkas terbaru yang berhasil dibaca)
  aktif      Boolean    @default(false)
  masalah    Json?      // daftar masalah validasi (sheet hilang, sel kosong)
  identitas  Json?      // isian sheet Menu (tanggal TS, nama prodi)
  diunggahOlehId String?
  diprosesPada DateTime?
  tabel      TabelLKPS[]
  createdAt  DateTime   @default(now())

  @@index([proyekId])
}

model TabelLKPS {
  id        String     @id @default(cuid())
  berkasId  String
  berkas    BerkasLKPS @relation(fields: [berkasId], references: [id], onDelete: Cascade)
  kode      String     // 4.a
  sheet     String
  judul     String     @default("")
  blok      String?    // label blok jenjang untuk 6.d dan 6.f.1
  kolom     Json       @default("[]") // [{ kunci, nomor, label }] kunci = huruf kolom template
  kolomRumus String[]
  baris     Json       // [{ nomorBaris, sel: { A: .., B: .. } }]; label TS dipertahankan, tahun nyata dihitung dari proyek
  perluDicek Boolean   @default(false) // true untuk hasil ekstraksi PDF sampai dikoreksi/dicek penanggung jawab
  dikoreksi Boolean    @default(false)
  urutan    Int        @default(0)
  updatedAt DateTime   @default(now()) @updatedAt

  @@unique([berkasId, sheet])
}

model Dokumen {
  id          String    @id @default(cuid())
  // milik satu LED, atau (proyekId null) dokumen bersama fakultas yang dipakai semua LED (U-10)
  proyekId    String?
  proyek      ProyekLED? @relation(fields: [proyekId], references: [id], onDelete: Cascade)
  subBagianKode String? // dokumen bisa umum (null) atau khusus satu sub-bagian
  butirKode   String?
  namaBerkas  String
  mime        String
  lokasi      String
  ukuran      Int
  tautanBukti String?   // tautan penyimpanan awan untuk lampiran (usulan U-02)
  jenis       String    @default("pdf") // pdf, docx, gambar
  judul       String?   // judul gambar/dokumen untuk disisipkan ke narasi
  hash        String?   // SHA-256 berkas asli
  dokumenDiharapkanId String?
  dokumenDiharapkan DokumenDiharapkan? @relation(fields: [dokumenDiharapkanId], references: [id], onDelete: SetNull)
  status      String    @default("diunggah") // diunggah, diproses, siap, gagal, menunggu_kunci
  pesan       String?
  jumlahPotongan Int    @default(0)
  diunggahOlehId String?
  diprosesPada DateTime?
  potongan    Potongan[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @default(now()) @updatedAt

  @@index([proyekId, subBagianKode])
}

model Potongan {
  id        String   @id @default(cuid())
  dokumenId String
  dokumen   Dokumen  @relation(fields: [dokumenId], references: [id], onDelete: Cascade)
  urutan    Int
  teks      String
  halaman   Int?
  modelEmbedding String
  embedding Unsupported("vector(768)")? // Gemini embedding dengan outputDimensionality 768; indeks HNSW lewat migrasi SQL
  // tsvector untuk pencarian kata kunci: kolom terbangkitkan (GENERATED) dibuat lewat migrasi SQL
  teksTsv   Unsupported("tsvector")? @default(dbgenerated("to_tsvector('simple'::regconfig, COALESCE(teks, ''::text))"))

  @@index([dokumenId])
  @@index([teksTsv], type: Gin, map: "Potongan_teksTsv_gin_idx")
}

// ----------------------------------------------------------------- Hasil

model BagianDraf {
  id          String     @id @default(cuid())
  proyekId    String
  proyek      ProyekLED  @relation(fields: [proyekId], references: [id], onDelete: Cascade)
  subBagianId String
  subBagian   SubBagian  @relation(fields: [subBagianId], references: [id])
  status      StatusPengisian @default(belum)
  versiAktifId String?
  versi       VersiDraf[]
  updatedAt   DateTime   @default(now()) @updatedAt

  @@unique([proyekId, subBagianId])
}

model VersiDraf {
  id          String     @id @default(cuid())
  bagianDrafId String
  bagianDraf  BagianDraf @relation(fields: [bagianDrafId], references: [id], onDelete: Cascade)
  nomor       Int
  asal        String     // generate, sunting, pulihkan
  isi         Json       // dokumen Tiptap (JSON) atau struktur paragraf
  sumber      Json?      // sumber per paragraf
  unsur       Json?      // status unsur skor 4
  dokumenKurang String[]
  pemeriksaan Json?      // hasil cek panjang, angka, sumber
  model       String?
  keluaranMentah Json?
  jumlahKata  Int        @default(0)
  dibuatOlehId String?
  dibuatOleh  User?      @relation(fields: [dibuatOlehId], references: [id], onDelete: SetNull)
  tugasId     String?    // tugas generate yang membuat versi ini
  createdAt   DateTime   @default(now())

  @@unique([bagianDrafId, nomor])
}

model Ekspor {
  id           String    @id @default(cuid())
  proyekId     String
  proyek       ProyekLED @relation(fields: [proyekId], references: [id], onDelete: Cascade)
  lokasi       String?   // berkas .docx di UPLOAD_DIR (null selama diproses atau bila gagal)
  namaBerkas   String?
  ukuran       Int?
  jumlahHalaman Int?
  halamanPerkiraan Boolean @default(false) // true bila LibreOffice tidak tersedia (jumlah halaman diperkirakan)
  status       String    @default("antre") // antre, diproses, siap, ditahan (> 150 halaman), gagal
  pesan        String?
  pemeriksaan  Json?     // galat dan peringatan
  dibuatOlehId String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @default(now()) @updatedAt

  @@index([proyekId])
}

// ----------------------------------------------------------------- Pengaturan LLM

model PengaturanLLM {
  id             String   @id @default("utama")
  penyedia       String   @default("google")
  modelNarasi    String
  modelCadangan  String[]
  modelEmbedding String
  suhu           Float    @default(0.2)
  maksTokenKeluaran Int   @default(4096)
  pakaiCadanganAdmin Boolean @default(true)
  daftarModel    Json?    // hasil models.list Google terakhir (nama, kode, metode, batas token)
  daftarModelDiperbarui DateTime?
  updatedAt      DateTime @updatedAt
}

enum PemilikKunci {
  penanggung_jawab
  super_admin
}

enum StatusKunci {
  aktif
  kuota_habis
  tidak_valid
  nonaktif
}

model KunciAPI {
  id          String       @id @default(cuid())
  label       String
  penyedia    String       @default("google")
  kunciTerenkripsi String  // AES-256-GCM; tidak pernah dikirim ke browser
  akhiran     String       // 4 karakter terakhir untuk tampilan
  pemilik     PemilikKunci
  // akun yang menambahkan; kunci milik fakultas (pemilik penanggung_jawab) atau cadangan admin (super_admin)
  pemilikId   String?
  pemilikUser User?        @relation(fields: [pemilikId], references: [id], onDelete: SetNull)
  status      StatusKunci  @default(aktif)
  habisSampai DateTime?
  urutan      Int          @default(0)
  batasHarian Int?
  log         LogPemakaian[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model LogPemakaian {
  id          String    @id @default(cuid())
  kunciId     String?
  kunci       KunciAPI? @relation(fields: [kunciId], references: [id], onDelete: SetNull)
  proyekId    String?
  subBagianKode String?
  model       String
  tokenMasuk  Int       @default(0)
  tokenKeluar Int       @default(0)
  berhasil    Boolean
  galat       String?
  tugasId     String?
  prodiId     String?
  durasiMs    Int?
  createdAt   DateTime  @default(now())
}

model LogAktivitas {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  aksi      String
  objek     String
  objekId   String?
  detail    Json?
  createdAt DateTime @default(now())
}

// ----------------------------------------------------------------- Tugas generate (antrean)

// Satu tugas = satu tombol generate (satu sub-bagian, satu kriteria, atau satu bagian). Worker mengerjakan
// sub-bagian berurutan mulai `indeks`; bila kunci habis tugas "tertunda" dan dilanjutkan dari indeks yang sama.
model TugasGenerate {
  id            String    @id @default(cuid())
  proyekId      String
  proyek        ProyekLED @relation(fields: [proyekId], references: [id], onDelete: Cascade)
  bagianKode    String?   // diisi untuk generate kriteria/bagian
  judul         String
  subBagianKode String[]  // urutan pengerjaan
  indeks        Int       @default(0)
  status        String    @default("antre") // antre, berjalan, tertunda, selesai, gagal, dibatalkan
  pesan         String?
  dilanjutkanPada DateTime? // perkiraan waktu dicoba lagi (reset kuota)
  pratinjau       Json? // revisi 22 Okt 2026: teks yang sedang ditulis per sub-bagian { kode: { teks, diperbarui } }
  dibuatOlehId  String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @default(now()) @updatedAt

  @@index([proyekId, status])
}
